<%- include('../partials/header',{title,currentUser}) %>
<div class="mb-4"><h1 class="h2 mb-1">Bản đồ vị trí đỗ</h1><p class="text-secondary">Lưới chỉ hiển thị mã vị trí, zone và trạng thái.</p></div>
<div class="row g-2 mb-3"><div class="col-sm-4"><select id="map-zone" class="form-select"><option value="">Tất cả zone</option></select></div><div class="col-sm-4"><select id="map-status" class="form-select"><option value="">Tất cả trạng thái</option><option>AVAILABLE</option><option>RESERVED</option><option>OCCUPIED</option><option>MAINTENANCE</option></select></div></div>
<div id="map-feedback" aria-live="polite"></div><div id="parking-grid" class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3"></div>
<div class="modal fade" id="slot-vehicle-modal" tabindex="-1" aria-labelledby="slot-vehicle-title" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="slot-vehicle-title">Thông tin vị trí</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body" id="slot-vehicle-details"></div></div></div></div>
<div class="modal fade" id="slot-register-modal" tabindex="-1" aria-labelledby="slot-register-title" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form id="slot-register-form"><div class="modal-header"><h2 class="modal-title fs-5" id="slot-register-title">Đăng ký vị trí</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><div id="register-error" class="alert alert-danger d-none"></div><input type="hidden" name="slotId"><label class="form-label" for="register-vehicle-id">Mã xe</label><input class="form-control" id="register-vehicle-id" name="vehicleId" type="number" min="1" required><div class="form-text">Tìm xe qua nút “Tìm xe” ở thanh điều hướng.</div></div><div class="modal-footer"><button class="btn btn-primary">Đăng ký</button></div></form></div></div></div></div>
<script src="/js/parking-map.js" defer></script>
<%- include('../partials/footer') %>
