<%- include('../partials/header',{title,currentUser}) %>
<div class="mb-4"><h1 class="h2 mb-1">Xe vào / ra</h1><p class="text-secondary">Tải ảnh biển số để nhận diện bằng bộ OCR mock của Sprint 1.</p></div>
<div id="parking-feedback" aria-live="polite"></div>
<div class="row g-4">
  <div class="col-lg-6"><section class="card border-0 shadow-sm h-100"><div class="card-body">
    <h2 class="h5">Quét biển số và check-in</h2>
    <form id="plate-scan-form">
      <label class="form-label" for="plateImage">Ảnh biển số (JPEG, PNG, WebP, tối đa 5 MB)</label>
      <input class="form-control" type="file" id="plateImage" name="plateImage" accept="image/jpeg,image/png,image/webp" required>
      <button class="btn btn-outline-primary mt-3" type="submit">Nhận diện biển số</button>
    </form>
    <div id="scan-result" class="mt-3"></div>
    <button id="create-visitor-button" type="button" class="btn btn-outline-secondary d-none" data-bs-toggle="modal" data-bs-target="#vehicle-modal">Thêm xe vãng lai</button>
    <form id="check-in-form" class="mt-3 d-none">
      <input type="hidden" name="vehicleId">
      <input type="hidden" name="scanToken">
      <label class="form-label" for="check-in-slot">Vị trí đỗ</label>
      <select class="form-select" id="check-in-slot" name="slotId" required>
        <% slots.forEach(slot => { if (slot.status==='AVAILABLE' || slot.status==='RESERVED') { %>
          <option value="<%= slot.id %>"><%= slot.slotCode %> · <%= slot.status %></option>
        <% } }) %>
      </select>
      <button class="btn btn-primary mt-3" type="submit">Xác nhận xe vào</button>
    </form>
  </div></section></div>
  <div class="col-lg-6"><section class="card border-0 shadow-sm h-100"><div class="card-body">
    <h2 class="h5">Xe đang trong bãi</h2>
    <% if (!sessions.length) { %><p class="text-secondary">Không có phiên gửi xe đang mở.</p><% } else { %>
      <div class="list-group"><% sessions.forEach(session => { %>
        <form class="list-group-item d-flex justify-content-between align-items-center gap-3" data-checkout-form>
          <input type="hidden" name="sessionId" value="<%= session.sessionId %>">
          <span><strong><%= session.licensePlate %></strong> · <%= session.vehicleName %><span class="d-block small text-secondary"><%= session.slotCode %></span></span>
          <button class="btn btn-sm btn-outline-danger" type="submit">Xe ra</button>
        </form>
      <% }) %></div>
    <% } %>
  </div></section></div>
</div>
<%- include('../partials/vehicle-modal') %>
<script src="/js/parking.js" defer></script>
<%- include('../partials/footer') %>
