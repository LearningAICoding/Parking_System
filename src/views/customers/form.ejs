<%- include('../partials/head', { title }) %><%- include('../partials/header') %><div class="app-layout"><%- include('../partials/sidebar') %><div class="app-main"><main class="w-full py-6 px-4 lg:px-6">
<div class="mb-6"><a href="/customers">← Danh sách khách hàng</a><h1 class="text-3xl font-bold mt-2"><%= customer ? 'Sửa khách hàng' : 'Thêm khách hàng' %></h1></div>
<div class="ui-card border-0 shadow-sm form-card"><div class="ui-card-body p-6">
  <% if (error) { %><div class="ui-alert ui-alert-danger"><%= error %></div><% } %>
  <form method="post" action="<%= customer ? '/customers/'+customer.id+'/edit' : '/customers/create' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid grid-cols-12 gap-4">
      <div class="col-span-12 md:col-span-6"><label class="ui-label" for="fullName">Họ và tên *</label><input id="fullName" class="ui-input" name="fullName" maxlength="100" required value="<%= customer?.fullName || '' %>"></div>
      <div class="col-span-12 md:col-span-6"><label class="ui-label" for="phone">Số điện thoại *</label><input id="phone" class="ui-input" name="phone" maxlength="13" required value="<%= customer?.phone || '' %>"></div>
      <div class="col-span-12 md:col-span-6"><label class="ui-label" for="email">Email *</label><input id="email" class="ui-input" name="email" type="email" maxlength="150" required value="<%= customer?.email || '' %>"></div>
      <div class="col-span-12 md:col-span-6"><label class="ui-label" for="address">Địa chỉ</label><input id="address" class="ui-input" name="address" maxlength="255" value="<%= customer?.address || '' %>"></div>
      <% if (!customer) { %>
        <div class="col-span-12 md:col-span-6"><label class="ui-label" for="username">Tên đăng nhập *</label><input id="username" class="ui-input" name="username" required minlength="3" maxlength="50" autocomplete="username" value="<%= customer?.username || '' %>"></div>
        <div class="col-span-12 md:col-span-6"><label class="ui-label" for="password">Mật khẩu khởi tạo *</label><input id="password" class="ui-input" name="password" type="password" required minlength="12" autocomplete="new-password"><div class="ui-help">Tối thiểu 12 ký tự, gồm chữ hoa, chữ thường và chữ số.</div></div>
      <% } %>
      <div class="col-span-12 flex justify-end gap-2"><a class="ui-btn ui-btn-outline-secondary" href="/customers">Hủy</a><button class="ui-btn ui-btn-primary">Lưu</button></div>
    </div>
  </form>
</div></div>
</main><%- include('../partials/footer') %>
