<%- include('../partials/header',{title,currentUser}) %>
<div class="mb-4"><a href="/customers">← Danh sách khách hàng</a><h1 class="h2 mt-2"><%= customer ? 'Sửa khách hàng' : 'Thêm khách hàng' %></h1></div>
<div class="card border-0 shadow-sm form-card"><div class="card-body p-4">
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form method="post" action="<%= customer ? '/customers/'+customer.id+'/edit' : '/customers/create' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label" for="fullName">Họ và tên *</label><input id="fullName" class="form-control" name="fullName" maxlength="100" required value="<%= customer?.fullName || '' %>"></div>
      <div class="col-md-6"><label class="form-label" for="phone">Số điện thoại *</label><input id="phone" class="form-control" name="phone" maxlength="13" required value="<%= customer?.phone || '' %>"></div>
      <div class="col-md-6"><label class="form-label" for="email">Email *</label><input id="email" class="form-control" name="email" type="email" maxlength="150" required value="<%= customer?.email || '' %>"></div>
      <div class="col-md-6"><label class="form-label" for="address">Địa chỉ</label><input id="address" class="form-control" name="address" maxlength="255" value="<%= customer?.address || '' %>"></div>
      <% if (!customer) { %>
        <div class="col-md-6"><label class="form-label" for="username">Tên đăng nhập *</label><input id="username" class="form-control" name="username" required minlength="3" maxlength="50" autocomplete="username" value="<%= customer?.username || '' %>"></div>
        <div class="col-md-6"><label class="form-label" for="password">Mật khẩu khởi tạo *</label><input id="password" class="form-control" name="password" type="password" required minlength="12" autocomplete="new-password"><div class="form-text">Tối thiểu 12 ký tự, gồm chữ hoa, chữ thường và chữ số.</div></div>
      <% } %>
      <div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="/customers">Hủy</a><button class="btn btn-primary">Lưu</button></div>
    </div>
  </form>
</div></div>
<%- include('../partials/footer') %>
