<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %> · Parking System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <% if (typeof demoPreview !== 'undefined' && demoPreview) { %>
    <div class="alert alert-warning rounded-0 mb-0 d-flex flex-wrap justify-content-center gap-3" role="status">
      <strong>BẢN XEM TRƯỚC · DỮ LIỆU GIẢ LẬP · KHÔNG LƯU VÀO DATABASE</strong>
      <span>Vai trò:</span>
      <a href="<%= demoRoleUrl('MANAGER') %>">MANAGER</a>
      <a href="<%= demoRoleUrl('STAFF') %>">STAFF</a>
      <a href="<%= demoRoleUrl('CUSTOMER') %>">CUSTOMER</a>
    </div>
  <% } %>
  <nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid px-lg-4">
      <a class="navbar-brand fw-bold" href="/">ParkCore</a>
      <% if (currentUser) { %>
        <div class="d-flex align-items-center gap-3 text-white">
          <span><%= currentUser.fullName %> · <%= currentUser.role %></span>
          <form method="post" action="/logout" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-outline-light">Đăng xuất</button>
          </form>
        </div>
      <% } %>
    </div>
  </nav>
  <% if (currentUser) { %>
    <div class="container-fluid">
      <div class="row min-vh-100">
        <aside class="col-12 col-lg-2 bg-light border-end py-3">
          <nav class="nav nav-pills flex-column gap-1" aria-label="Điều hướng chính">
            <a class="nav-link <%= path==='/'?'active':'' %>" href="/">Trang chủ</a>
            <a class="nav-link <%= path==='/news'?'active':'' %>" href="/news">Tin tức</a>
            <% if (['MANAGER','STAFF'].includes(currentUser.role)) { %>
              <a class="nav-link <%= path.startsWith('/customers')?'active':'' %>" href="/customers">Khách hàng</a>
              <a class="nav-link <%= path==='/parking/checkin-checkout'?'active':'' %>" href="/parking/checkin-checkout">Xe vào / ra</a>
              <a class="nav-link <%= path==='/parking/map'?'active':'' %>" href="/parking/map">Bản đồ</a>
              <a class="nav-link <%= path.startsWith('/tickets')?'active':'' %>" href="/tickets">Vé</a>
              <a class="nav-link <%= path.startsWith('/slots')?'active':'' %>" href="/slots">Vị trí đỗ</a>
              <button class="nav-link text-start" type="button" data-bs-toggle="modal" data-bs-target="#vehicle-search-modal">Tìm xe</button>
            <% } else { %>
              <a class="nav-link <%= path==='/my-vehicles'?'active':'' %>" href="/my-vehicles">Xe của tôi</a>
              <a class="nav-link <%= path==='/profile'?'active':'' %>" href="/profile">Hồ sơ</a>
              <a class="nav-link <%= path==='/customer/parking-map'?'active':'' %>" href="/customer/parking-map">Bản đồ</a>
            <% } %>
            <% if (currentUser.role==='MANAGER') { %>
              <a class="nav-link <%= path.startsWith('/employees')?'active':'' %>" href="/employees">Nhân viên</a>
              <a class="nav-link <%= path.startsWith('/stats')?'active':'' %>" href="/stats">Thống kê</a>
            <% } %>
          </nav>
        </aside>
        <main class="col-12 col-lg-10 py-4 px-lg-4">
  <% } else { %>
    <main class="container py-4">
  <% } %>
