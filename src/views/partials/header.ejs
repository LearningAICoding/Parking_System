<header class="app-header sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="flex h-16 w-full items-center gap-3 px-4 lg:px-6">
    <button class="ui-btn ui-btn-outline-secondary lg:hidden" type="button" data-ui-toggle="offcanvas" data-ui-target="#appSidebar" aria-label="Mở menu" aria-controls="appSidebar">
      <span aria-hidden="true">☰</span>
    </button>
    <a class="text-lg font-bold tracking-tight text-primary" href="/">ParkCore<span class="text-slate-900"> Precision</span></a>
    <div class="ml-auto flex items-center gap-3">
      <span class="hidden text-sm font-medium text-slate-600 sm:inline"><%= currentUser?.fullName || currentUser?.username %></span>
      <form method="post" action="/logout" class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="ui-btn ui-btn-sm ui-btn-outline-secondary" type="submit">Đăng xuất</button>
      </form>
    </div>
  </div>
</header>
