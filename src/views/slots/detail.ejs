<%- include('../partials/header', { title }) %>
<%- include('../parking/_assets') %>
<%
  const show = (value) => (value == null || value === '' ? '—' : value);
%>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb small">
    <li class="breadcrumb-item"><a href="/slots">Vị trí đỗ</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= slot.slotCode %></li>
  </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h4 mb-0">
    Vị trí <%= slot.slotCode %> <%- include('_status-badge', { status: slot.status }) %>
  </h1>
  <div class="d-flex gap-2">
    <a href="/slots" class="btn btn-outline-secondary" data-slot-back>Quay lại</a>
    <% if (canManage) { %>
      <% if (!modifiable) { %>
        <span class="d-inline-block" tabindex="0" title="Vị trí đang có xe, không thể sửa hoặc xóa" data-locked-hint>
          <button type="button" class="btn btn-outline-primary" disabled data-slot-locked>Sửa</button>
          <button type="button" class="btn btn-outline-danger" disabled data-slot-locked>Xóa</button>
        </span>
      <% } else { %>
        <a href="/slots/<%= slot.id %>/edit" class="btn btn-outline-primary">Sửa</a>
        <button type="button" class="btn btn-outline-danger" data-slot-delete
          data-slot-id="<%= slot.id %>" data-slot-code="<%= slot.slotCode %>">Xóa</button>
      <% } %>
    <% } %>
  </div>
</div>

<div class="alert alert-danger" role="alert" hidden data-slot-back-error></div>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header fw-semibold">Vị trí đỗ</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5">Vị trí đỗ</dt><dd class="col-7"><%= slot.slotCode %></dd>
          <dt class="col-5">Khu vực / Tầng</dt><dd class="col-7"><%= slot.zone %></dd>
          <dt class="col-5">Trạng thái</dt><dd class="col-7"><%- include('_status-badge', { status: slot.status }) %></dd>
          <dt class="col-5">Ghi chú</dt><dd class="col-7 mb-0"><%= show(slot.note) %></dd>
        </dl>
      </div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header fw-semibold">Khách hàng và xe đăng ký</div>
      <div class="card-body">
        <% if (!slot.vehicleId) { %>
          <p class="pc-muted mb-0" data-testid="slot-no-vehicle">Vị trí chưa có xe đăng ký.</p>
        <% } else { %>
          <dl class="row mb-0">
            <dt class="col-5">Họ và tên KH</dt><dd class="col-7"><%= slot.customerName || 'Xe vãng lai' %></dd>
            <dt class="col-5">Email</dt><dd class="col-7 text-break"><%= show(slot.customerEmail) %></dd>
            <dt class="col-5">Số điện thoại</dt>
            <dd class="col-7">
              <% if (slot.customerPhone) { %><a href="tel:<%= slot.customerPhone %>"><%= slot.customerPhone %></a><% } else { %>—<% } %>
            </dd>
            <dt class="col-5">Loại xe</dt><dd class="col-7"><%= labels.vehicleType[slot.vehicleType] || show(slot.vehicleType) %></dd>
            <dt class="col-5">Hãng xe</dt><dd class="col-7"><%= show(slot.brand) %></dd>
            <dt class="col-5">Tên xe</dt><dd class="col-7"><%= show(slot.vehicleName) %></dd>
            <dt class="col-5">Biển số xe</dt><dd class="col-7 mb-0"><span class="pc-plate"><%= slot.licensePlate %></span></dd>
          </dl>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% if (canManage && modifiable) { %>
  <%- include('_delete-modal') %>
<% } %>
<script src="/js/slots.js" defer></script>
<%- include('../partials/footer') %>
