<%- include('../partials/head', { title }) %><%- include('../partials/header') %><div class="app-layout"><%- include('../partials/sidebar') %><div class="app-main"><main class="w-full py-6 px-4 lg:px-6">
<%- include('../parking/_assets') %>
<%
  const show = (value) => (value == null || value === '' ? '—' : value);
%>
<nav aria-label="breadcrumb">
  <ol class="ui-breadcrumb text-sm">
    <li class="ui-breadcrumb-item"><a href="/slots">Vị trí đỗ</a></li>
    <li class="ui-breadcrumb-item active" aria-current="page"><%= slot.slotCode %></li>
  </ol>
</nav>

<div class="flex flex-wrap justify-between items-center gap-2 mb-4">
  <h1 class="text-xl font-semibold mb-0">
    Vị trí <%= slot.slotCode %> <%- include('_status-badge', { status: slot.status }) %>
  </h1>
  <div class="flex gap-2">
    <a href="/slots" class="ui-btn ui-btn-outline-secondary" data-slot-back>Quay lại</a>
    <% if (canManage) { %>
      <% if (!modifiable) { %>
        <span class="inline-block" tabindex="0" title="Vị trí đang có xe, không thể sửa hoặc xóa" data-locked-hint>
          <button type="button" class="ui-btn ui-btn-outline-primary" disabled data-slot-locked>Sửa</button>
          <button type="button" class="ui-btn ui-btn-outline-danger" disabled data-slot-locked>Xóa</button>
        </span>
      <% } else { %>
        <a href="/slots/<%= slot.id %>/edit" class="ui-btn ui-btn-outline-primary">Sửa</a>
        <button type="button" class="ui-btn ui-btn-outline-danger" data-slot-delete
          data-slot-id="<%= slot.id %>" data-slot-code="<%= slot.slotCode %>">Xóa</button>
      <% } %>
    <% } %>
  </div>
</div>

<div class="ui-alert ui-alert-danger" role="alert" hidden data-slot-back-error></div>

<div class="grid grid-cols-12 gap-4">
  <div class="lg:col-span-5">
    <div class="ui-card h-full">
      <div class="ui-card-header font-semibold">Vị trí đỗ</div>
      <div class="ui-card-body">
        <dl class="grid grid-cols-12 mb-0">
          <dt class="col-span-5">Vị trí đỗ</dt><dd class="col-span-7"><%= slot.slotCode %></dd>
          <dt class="col-span-5">Khu vực / Tầng</dt><dd class="col-span-7"><%= slot.zone %></dd>
          <dt class="col-span-5">Trạng thái</dt><dd class="col-span-7"><%- include('_status-badge', { status: slot.status }) %></dd>
          <dt class="col-span-5">Ghi chú</dt><dd class="col-span-7 mb-0"><%= show(slot.note) %></dd>
        </dl>
      </div>
    </div>
  </div>
  <div class="lg:col-span-7">
    <div class="ui-card h-full">
      <div class="ui-card-header font-semibold">Khách hàng và xe đăng ký</div>
      <div class="ui-card-body">
        <% if (!slot.vehicleId) { %>
          <p class="pc-muted mb-0" data-testid="slot-no-vehicle">Vị trí chưa có xe đăng ký.</p>
        <% } else { %>
          <dl class="grid grid-cols-12 mb-0">
            <dt class="col-span-5">Họ và tên KH</dt><dd class="col-span-7"><%= slot.customerName || 'Xe vãng lai' %></dd>
            <dt class="col-span-5">Email</dt><dd class="col-span-7 break-words"><%= show(slot.customerEmail) %></dd>
            <dt class="col-span-5">Số điện thoại</dt>
            <dd class="col-span-7">
              <% if (slot.customerPhone) { %><a href="tel:<%= slot.customerPhone %>"><%= slot.customerPhone %></a><% } else { %>—<% } %>
            </dd>
            <dt class="col-span-5">Loại xe</dt><dd class="col-span-7"><%= labels.vehicleType[slot.vehicleType] || show(slot.vehicleType) %></dd>
            <dt class="col-span-5">Hãng xe</dt><dd class="col-span-7"><%= show(slot.brand) %></dd>
            <dt class="col-span-5">Tên xe</dt><dd class="col-span-7"><%= show(slot.vehicleName) %></dd>
            <dt class="col-span-5">Biển số xe</dt><dd class="col-span-7 mb-0"><span class="pc-plate"><%= slot.licensePlate %></span></dd>
          </dl>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% if (canManage && modifiable) { %>
  <%- include('_delete-modal') %>
<% } %>
<script src="/js/slots.js" defer></script>
</main><%- include('../partials/footer') %>
