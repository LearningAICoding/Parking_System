<%- include('../partials/header',{title,currentUser}) %><div class="mb-4"><a href="/employees" class="text-decoration-none">← Danh sách nhân viên</a><h1 class="h2 mt-2"><%= employee ? 'Sửa thông tin nhân viên' : 'Thêm nhân viên' %></h1><p class="text-secondary">Chỉ quản lý (MANAGER) được thực hiện thao tác này.</p></div><div class="card border-0 shadow-sm form-card"><div class="card-body p-4"><% if(error) { %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="<%= employee ? '/employees/'+employee.id+'/edit' : '/employees/create' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-md-6"><label class="form-label">Họ và tên *</label><input class="form-control" name="fullName" required maxlength="100" value="<%= employee?.fullName || '' %>"></div><div class="col-md-6"><label class="form-label">Email *</label><input class="form-control" name="email" type="email" required maxlength="150" value="<%= employee?.email || '' %>"></div><% if(!employee) { %><div class="col-md-6"><label class="form-label">Tên đăng nhập *</label><input class="form-control" name="username" required minlength="3" maxlength="50" value="<%= employee?.username || '' %>"></div><div class="col-md-6"><label class="form-label">Mật khẩu tạm *</label><input class="form-control" name="password" type="password" minlength="12" required autocomplete="new-password"><div class="form-text">Ít nhất 12 ký tự, có chữ hoa, chữ thường và chữ số.</div></div><% } %><div class="col-md-6"><label class="form-label">Số điện thoại</label><input class="form-control" name="phone" value="<%= employee?.phone || '' %>" maxlength="15"></div><div class="col-md-6"><label class="form-label">Chức vụ</label><input class="form-control" name="position" value="<%= employee?.position || '' %>" maxlength="100"></div><div class="col-12"><label class="form-label">Địa chỉ</label><input class="form-control" name="address" value="<%= employee?.address || '' %>" maxlength="255"></div><% if(!employee) { %><div class="col-md-6"><label class="form-label">Vai trò *</label><select class="form-select" name="role" required><option value="STAFF">STAFF — Nhân viên</option><option value="MANAGER">MANAGER — Quản lý</option></select></div><% } %><div class="col-12 d-flex justify-content-end gap-2 mt-4"><a class="btn btn-outline-secondary" href="/employees">Hủy</a><button class="btn btn-primary"><%= employee ? 'Lưu thay đổi' : 'Tạo nhân viên' %></button></div></div></form></div></div><%- include('../partials/footer') %>
