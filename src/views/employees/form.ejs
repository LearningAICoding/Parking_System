<%- include('../partials/head', { title }) %><%- include('../partials/header') %><div class="app-layout"><%- include('../partials/sidebar') %><div class="app-main"><main class="w-full py-6 px-4 lg:px-6"><div class="mb-6"><a href="/employees" class="no-underline">← Danh sách nhân viên</a><h1 class="text-3xl font-bold mt-2"><%= employee ? 'Sửa thông tin nhân viên' : 'Thêm nhân viên' %></h1><p class="text-slate-600">Chỉ quản lý (MANAGER) được thực hiện thao tác này.</p></div><div class="ui-card border-0 shadow-sm form-card"><div class="ui-card-body p-6"><% if(error) { %><div class="ui-alert ui-alert-danger"><%= error %></div><% } %><form method="post" action="<%= employee ? '/employees/'+employee.id+'/edit' : '/employees/create' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="grid grid-cols-12 gap-4"><div class="col-span-12 md:col-span-6"><label class="ui-label">Họ và tên *</label><input class="ui-input" name="fullName" required maxlength="100" value="<%= employee?.fullName || '' %>"></div><div class="col-span-12 md:col-span-6"><label class="ui-label">Email *</label><input class="ui-input" name="email" type="email" required maxlength="150" value="<%= employee?.email || '' %>"></div><% if(!employee) { %><div class="col-span-12 md:col-span-6"><label class="ui-label">Tên đăng nhập *</label><input class="ui-input" name="username" required minlength="3" maxlength="50" value="<%= employee?.username || '' %>"></div><div class="col-span-12 md:col-span-6"><label class="ui-label">Mật khẩu tạm *</label><input class="ui-input" name="password" type="password" minlength="12" required autocomplete="new-password"><div class="ui-help">Ít nhất 12 ký tự, có chữ hoa, chữ thường và chữ số.</div></div><% } %><div class="col-span-12 md:col-span-6"><label class="ui-label">Số điện thoại</label><input class="ui-input" name="phone" value="<%= employee?.phone || '' %>" maxlength="15"></div><div class="col-span-12 md:col-span-6"><label class="ui-label">Chức vụ</label><input class="ui-input" name="position" value="<%= employee?.position || '' %>" maxlength="100"></div><div class="col-span-12"><label class="ui-label">Địa chỉ</label><input class="ui-input" name="address" value="<%= employee?.address || '' %>" maxlength="255"></div><% if(!employee) { %><div class="col-span-12 md:col-span-6"><label class="ui-label">Vai trò *</label><select class="ui-select" name="role" required><option value="STAFF">STAFF — Nhân viên</option><option value="MANAGER">MANAGER — Quản lý</option></select></div><% } %><div class="col-span-12 flex justify-end gap-2 mt-6"><a class="ui-btn ui-btn-outline-secondary" href="/employees">Hủy</a><button class="ui-btn ui-btn-primary"><%= employee ? 'Lưu thay đổi' : 'Tạo nhân viên' %></button></div></div></form></div></div></main><%- include('../partials/footer') %>

