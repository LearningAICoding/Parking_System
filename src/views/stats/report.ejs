<%- include('../partials/header',{title,currentUser}) %>
<div class="mb-4"><h1 class="h2 mb-1">Thống kê bãi đỗ</h1><p class="text-secondary">Báo cáo hoạt động và doanh thu theo ngày, tháng hoặc năm.</p></div>
<div id="stats-error" class="alert alert-danger d-none" role="alert"></div>
<form id="stats-filter" class="row g-3 mb-4">
  <div class="col-md-3"><label class="form-label" for="stats-mode">Gom nhóm</label><select class="form-select" id="stats-mode" name="mode"><option value="day">Theo ngày</option><option value="month">Theo tháng</option><option value="year">Theo năm</option></select></div>
  <div class="col-md-3"><label class="form-label" for="stats-from">Từ ngày</label><input class="form-control" type="date" id="stats-from" name="from" required></div>
  <div class="col-md-3"><label class="form-label" for="stats-to">Đến ngày</label><input class="form-control" type="date" id="stats-to" name="to" required></div>
  <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary">Xem báo cáo</button></div>
</form>
<div class="row g-3 mb-4" id="stats-summary"></div>
<div class="card border-0 shadow-sm"><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>Kỳ</th><th>Lượt vào</th><th>Lượt ra</th><th>Doanh thu vé</th><th>Doanh thu lượt lẻ</th></tr></thead><tbody id="stats-series"><tr><td colspan="5" class="text-secondary">Chọn khoảng thời gian để tải báo cáo.</td></tr></tbody></table></div></div></div>
<script src="/js/stats.js" defer></script>
<%- include('../partials/footer') %>
