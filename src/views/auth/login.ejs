<%- include('../partials/header',{title,currentUser:null}) %><div class="auth-card card border-0 shadow-sm mx-auto"><div class="card-body p-4 p-md-5"><div class="text-primary small fw-bold text-uppercase mb-2">Parking Management</div><h1 class="h3 mb-2">Đăng nhập hệ thống</h1><p class="text-secondary mb-4">Nhập tên đăng nhập hoặc email và mật khẩu của bạn.</p><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><% if (success) { %><div class="alert alert-success"><%= success %></div><% } %><form method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="next" value="<%= next || '/' %>"><div class="mb-3"><label class="form-label" for="login">Tên đăng nhập hoặc email</label><input class="form-control" id="login" name="login" autocomplete="username" required maxlength="150"></div><div class="mb-3"><label class="form-label" for="password">Mật khẩu</label><input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required></div><button class="btn btn-primary w-100 py-2">Đăng nhập</button></form><div class="text-center mt-3"><a href="/forgot-password">Quên mật khẩu?</a></div></div></div><%- include('../partials/footer') %>
