<%- include('../partials/header',{title,currentUser:null}) %><div class="auth-card card border-0 shadow-sm mx-auto"><div class="card-body p-4 p-md-5"><h1 class="h3">Quên mật khẩu?</h1><p class="text-secondary">Nhập email tài khoản. Nếu tồn tại, hệ thống sẽ gửi hướng dẫn khôi phục.</p><% if (notice) { %><div class="alert alert-info"><%= notice %></div><% } %><form method="post" action="/forgot-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="email">Email</label><input class="form-control mb-3" id="email" name="email" type="email" required maxlength="150"><button class="btn btn-primary w-100">Gửi hướng dẫn</button></form><div class="text-center mt-3"><a href="/login">Quay lại đăng nhập</a></div></div></div><%- include('../partials/footer') %>
