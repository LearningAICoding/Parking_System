<%- include('../partials/auth-head', { title }) %>
<main class="mx-auto w-full max-w-7xl px-4 py-10">
  <div class="grid grid-cols-12 justify-center">
    <div class="col-span-12 col-span-12 md:col-span-6 lg:col-span-5">
      <section class="ui-card shadow-sm border-0">
        <div class="ui-card-body p-6 lg:p-8">
          <a class="text-sm" href="/login">← Quay lại đăng nhập</a>
          <h1 class="text-2xl font-semibold mt-4 mb-2">Quên mật khẩu</h1>
          <p class="text-slate-600 mb-6">Nhập email tài khoản để nhận liên kết đặt lại mật khẩu.</p>
          <% if (sent) { %><div class="ui-alert ui-alert-success" role="status">Nếu email tồn tại, liên kết đặt lại mật khẩu đã được gửi.</div><% } %>
          <% if (formError) { %><div class="ui-alert ui-alert-danger" role="alert"><%= formError %></div><% } %>
          <form method="post" action="/forgot-password" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-4">
              <label class="ui-label" for="email">Email</label>
              <input class="ui-input" id="email" name="email" type="email" autocomplete="email" required>
            </div>
            <button class="ui-btn ui-btn-primary w-full" type="submit">Gửi liên kết</button>
          </form>
        </div>
      </section>
    </div>
  </div>
</main>
<%- include('../partials/auth-foot') %>
