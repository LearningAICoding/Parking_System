<%- include('../partials/header',{title,currentUser:null}) %><div class="auth-card card border-0 shadow-sm mx-auto"><div class="card-body p-4 p-md-5"><h1 class="h3">Đặt lại mật khẩu</h1><p class="text-secondary">Mật khẩu tối thiểu 12 ký tự, có chữ hoa, chữ thường và chữ số.</p><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/reset-password/<%= token %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="password">Mật khẩu mới</label><input class="form-control mb-3" id="password" name="password" type="password" minlength="12" required autocomplete="new-password"><button class="btn btn-primary w-100">Cập nhật mật khẩu</button></form></div></div><%- include('../partials/footer') %>
