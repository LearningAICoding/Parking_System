<%- include('../partials/auth-head', { title }) %>
<main class="mx-auto w-full max-w-7xl px-4 py-10">
  <div class="grid grid-cols-12 justify-center">
    <div class="col-span-12 col-span-12 md:col-span-6 lg:col-span-5">
      <section class="ui-card shadow-sm border-0">
        <div class="ui-card-body p-6 lg:p-8">
          <h1 class="text-2xl font-semibold mb-2">Đặt lại mật khẩu</h1>
          <p class="text-slate-600 mb-6">Mật khẩu mới phải có ít nhất 12 ký tự, gồm chữ hoa, chữ thường và chữ số.</p>
          <% if (formError) { %><div class="ui-alert ui-alert-danger" role="alert"><%= formError %></div><% } %>
          <form method="post" action="/reset-password/<%= token %>" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-4">
              <label class="ui-label" for="password">Mật khẩu mới</label>
              <input class="ui-input" id="password" name="password" type="password" autocomplete="new-password" minlength="12" required>
            </div>
            <div class="mb-4">
              <label class="ui-label" for="passwordConfirmation">Xác nhận mật khẩu</label>
              <input class="ui-input" id="passwordConfirmation" name="passwordConfirmation" type="password" autocomplete="new-password" minlength="12" required>
            </div>
            <button class="ui-btn ui-btn-primary w-full" type="submit">Cập nhật mật khẩu</button>
          </form>
        </div>
      </section>
    </div>
  </div>
</main>
<%- include('../partials/auth-foot') %>
