<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<div class="app-layout"><%- include('../partials/sidebar') %><div class="app-main"><main class="w-full py-6 px-4 lg:px-6"><div class="mb-6"><p class="uppercase text-sm text-primary font-semibold mb-1">Tài sản</p><h1 class="text-2xl font-semibold mb-1">Xe của tôi</h1><p class="text-slate-600 mb-0">Danh sách xe thuộc tài khoản CUSTOMER hiện tại.</p></div><div class="grid grid-cols-12 gap-4"><% if (!items.length) { %><div class="col-span-12"><div class="ui-alert ui-alert-light border">Bạn chưa có xe nào.</div></div><% } %><% items.forEach((vehicle) => { %><div class="col-span-12 lg:col-span-6"><article class="ui-card dashboard-card h-full"><div class="ui-card-body"><div class="flex justify-between gap-3"><div><h2 class="text-lg font-semibold mb-1"><%= vehicle.vehicleName %></h2><div class="font-mono text-primary"><%= vehicle.licensePlate %></div></div><span class="ui-badge <%= vehicle.derivedStatus === 'PARKED' ? 'ui-badge-danger' : vehicle.derivedStatus === 'RESERVED' ? 'ui-badge-warning' : 'ui-badge-success' %>"><%= vehicle.derivedStatus %></span></div><dl class="grid grid-cols-12 text-sm mt-4 mb-0"><dt class="col-span-5 text-slate-600">Hãng xe</dt><dd class="col-span-7"><%= vehicle.brand || 'Chưa cập nhật' %></dd><dt class="col-span-5 text-slate-600">Loại xe</dt><dd class="col-span-7"><%= vehicle.vehicleType %></dd><dt class="col-span-5 text-slate-600">Vị trí</dt><dd class="col-span-7"><%= vehicle.slotCode || 'Chưa có' %></dd><dt class="col-span-5 text-slate-600">Lần ra gần nhất</dt><dd class="col-span-7"><%= vehicle.lastExitTime ? new Date(vehicle.lastExitTime).toLocaleString('vi-VN') : 'Chưa có' %></dd></dl></div></article></div><% }) %></div></main><%- include('../partials/footer') %></div></div>
