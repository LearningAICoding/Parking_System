<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<div class="app-layout"><%- include('../partials/sidebar') %><div class="app-main"><main class="w-full py-6 px-4 lg:px-6"><div class="mb-6"><p class="uppercase text-sm text-primary font-semibold mb-1">Tài khoản</p><h1 class="text-2xl font-semibold mb-1">Hồ sơ khách hàng</h1><p class="text-slate-600 mb-0">Cập nhật thông tin liên hệ của chính bạn.</p></div><% if (req.query.updated === '1') { %><div class="ui-alert ui-alert-success" role="status">Đã cập nhật hồ sơ.</div><% } %><% if (formError) { %><div class="ui-alert ui-alert-danger" role="alert"><%= formError %></div><% } %><section class="ui-card dashboard-card"><div class="ui-card-body p-6"><form method="post" action="/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="grid grid-cols-12 gap-4"><div class="col-span-12 md:col-span-6"><label class="ui-label" for="fullName">Họ và tên</label><input class="ui-input" id="fullName" name="fullName" value="<%= values?.fullName || profile.fullName %>" required></div><div class="col-span-12 md:col-span-6"><label class="ui-label" for="phone">Số điện thoại</label><input class="ui-input" id="phone" name="phone" value="<%= values?.phone || profile.phone %>" required></div><div class="col-span-12 md:col-span-6"><label class="ui-label" for="email">Email</label><input class="ui-input" id="email" name="email" type="email" value="<%= values?.email || profile.email %>" required></div><div class="col-span-12 md:col-span-6"><label class="ui-label" for="username">Tên đăng nhập</label><input class="ui-input" id="username" value="<%= profile.username %>" disabled></div><div class="col-span-12"><label class="ui-label" for="address">Địa chỉ</label><textarea class="ui-input" id="address" name="address" rows="3"><%= values?.address || profile.address || '' %></textarea></div></div><div class="flex justify-end mt-6"><button class="ui-btn ui-btn-primary" type="submit">Lưu hồ sơ</button></div></form></div></section></main><%- include('../partials/footer') %></div></div>
