<%- include('../partials/header',{title,currentUser}) %>
<div class="mb-4"><h1 class="h2 mb-1">Bản đồ bãi đỗ</h1><p class="text-secondary">Chọn một ô AVAILABLE để đăng ký xe của bạn.</p></div>
<div id="map-feedback" aria-live="polite"></div><div id="parking-grid" class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3"></div>
<div class="modal fade" id="slot-register-modal" tabindex="-1" aria-labelledby="slot-register-title" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form id="slot-register-form"><div class="modal-header"><h2 class="modal-title fs-5" id="slot-register-title">Đăng ký vị trí</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><div id="register-error" class="alert alert-danger d-none"></div><input type="hidden" name="slotId"><label class="form-label" for="register-vehicle-id">Xe của bạn</label><select class="form-select" id="register-vehicle-id" name="vehicleId" required></select></div><div class="modal-footer"><button class="btn btn-primary">Đăng ký</button></div></form></div></div></div></div>
<div class="modal fade" id="registration-receipt" tabindex="-1" aria-labelledby="registration-receipt-title" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="registration-receipt-title">Đăng ký thành công</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body" id="receipt-content"></div></div></div></div>
<script src="/js/parking-map.js" defer></script>
<%- include('../partials/footer') %>
